{
  "name": "spartans1st-championship-git",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  // Live-only KV (spartans1st-live-daily); holds every daily message shown on the live site.
  // The test Worker uses its own namespace and cannot change live content.
  "kv_namespaces": [{ "binding": "DAILY", "id": "57fe9d6e4a5547a3a895da7e9161e989" }],
  // Pre-generate each day's message just after midnight Oklahoma time (CDT and CST).
  "triggers": { "crons": ["5 5 * * *", "5 6 * * *"] },
  "observability": { "enabled": true }
}
