{
  "name": "spartans1st-championship-git",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  // Same KV namespace as the test Worker, so live and test show the same daily message.
  "kv_namespaces": [{ "binding": "DAILY", "id": "57fe9d6e4a5547a3a895da7e9161e989" }],
  // No schedule here: the test Worker's midnight cron pre-generates each day's message
  // into this shared KV, and any first visit generates it on demand if needed.
  "observability": { "enabled": true }
}
