{
  "name": "spartans1st-countdown-test",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  // Test-only KV (spartans1st-test-daily). The live Worker uses its own namespace
  // (spartans1st-live-daily), so nothing done on the test site can change live content.
  "kv_namespaces": [{ "binding": "DAILY", "id": "c64d9a0e380d4b75b05b3cde674ae8df" }],
  // No cron on the test Worker: messages are created on demand when the test site is opened.
  // The midnight schedule belongs to the live Worker.
  // Test-only switches: let the test site preview future days and paint an AI scene for Page 2.
  // Never add these to the live Worker's config without Michael's approval.
  "vars": { "PREVIEW_FUTURE": "1", "AI_SCENES": "0" },
  "observability": { "enabled": true }
}
